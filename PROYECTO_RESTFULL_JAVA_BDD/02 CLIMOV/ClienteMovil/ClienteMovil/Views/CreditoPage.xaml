<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClienteMovil.Views.CreditoPage"
             Title="💳 Crédito BanQuito"
             BackgroundColor="{StaticResource BgPrimary}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🧹" 
                     Clicked="OnLimpiarFormularioClicked"
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <StackLayout Padding="16" Spacing="16">

            <!-- Indicador de estado general -->
            <Frame BackgroundColor="{StaticResource BgCard}"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="16">
                <StackLayout Orientation="Horizontal" Spacing="16">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                      IsVisible="False"
                                      IsRunning="False"
                                      Color="{StaticResource Primary}"
                                      WidthRequest="20"
                                      HeightRequest="20" />
                    <Label x:Name="StatusLabel"
                           Text="Sistema BanQuito listo"
                           FontSize="14"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                </StackLayout>
            </Frame>

            <!-- VALIDACIÓN DE CRÉDITO -->
            <Frame BackgroundColor="{StaticResource BgCard}"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="16">
                <StackLayout Spacing="16">
                    <Label Text="👤 Validación de Sujeto de Crédito"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Cédula -->
                        <Entry x:Name="EntryCedula"
                               Grid.Row="0" Grid.Column="0"
                               Placeholder="Ingrese la cédula del cliente"
                               BackgroundColor="{StaticResource BgSecondary}"
                               TextColor="{StaticResource BgCard}"
                               PlaceholderColor="{StaticResource BgCard}"
                               Keyboard="Numeric"
                               MaxLength="10"
                               HeightRequest="45" />

                        <Button Grid.Row="0" Grid.Column="1"
                                Text="✅"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="8"
                                WidthRequest="60"
                                HeightRequest="45"
                                Margin="8,0,0,0"
                                Clicked="OnValidarCreditoClicked" />

                        <!-- Resultado validación -->
                        <Label x:Name="LabelResultadoValidacion"
                               Grid.Row="1" Grid.ColumnSpan="2"
                               Text=""
                               FontSize="14"
                               IsVisible="False"
                               Margin="0,8,0,0" />

                        <!-- Botón calcular monto -->
                        <Button Grid.Row="2" Grid.ColumnSpan="2"
                                x:Name="ButtonCalcularMonto"
                                Text="💰 Calcular Monto Máximo"
                                BackgroundColor="{StaticResource Success}"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="45"
                                Margin="0,16,0,0"
                                Clicked="OnCalcularMontoClicked"
                                IsEnabled="False" />
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- RESULTADO MONTO MÁXIMO -->
            <Frame BackgroundColor="{StaticResource BgCard}"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="16">
                <StackLayout Spacing="16">
                    <Label Text="💰 Cálculo de Monto Máximo"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label x:Name="LabelResultadoMonto"
                           Text="Calcule el monto máximo para ver los resultados"
                           FontSize="14"
                           TextColor="{StaticResource TextSecondary}"
                           IsVisible="False" />

                    <!-- Información sobre el cálculo -->
                    <Frame BackgroundColor="{StaticResource BgSecondary}"
                           CornerRadius="8"
                           Padding="12">
                        <StackLayout Spacing="4">
                            <Label Text="📊 Fórmula de Cálculo"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="Monto Máximo = ((Prom. Depósitos - Prom. Retiros) × 60%) × 9"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Label Text="• Se consideran los últimos 3 meses de transacciones"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Label Text="• Máximo 9 meses de financiamiento"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}" />
                        </StackLayout>
                    </Frame>
                </StackLayout>
            </Frame>

            <!-- CONSULTA TABLA DE AMORTIZACIÓN -->
            <Frame BackgroundColor="{StaticResource BgCard}"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="16">
                <StackLayout Spacing="16">
                    <Label Text="📋 Consulta de Tabla de Amortización"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- ID Crédito -->
                        <Entry x:Name="EntryIdCredito"
                               Grid.Row="0" Grid.Column="0"
                               Placeholder="Ingrese el ID del crédito"
                               BackgroundColor="{StaticResource BgSecondary}"
                               TextColor="{StaticResource BgCard}"
                               PlaceholderColor="{StaticResource BgCard}"
                               Keyboard="Numeric"
                               HeightRequest="45" />

                        <Button Grid.Row="0" Grid.Column="1"
                                Text="🔍"
                                BackgroundColor="{StaticResource Info}"
                                TextColor="White"
                                CornerRadius="8"
                                WidthRequest="60"
                                HeightRequest="45"
                                Margin="8,0,0,0"
                                Clicked="OnConsultarTablaClicked" />
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- INFORMACIÓN DEL CRÉDITO -->
            <Frame x:Name="InfoCreditoFrame"
                   BackgroundColor="{StaticResource BgCard}"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="16"
                   IsVisible="False">
                <StackLayout Spacing="12">
                    <Label Text="🏦 Información del Crédito"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label x:Name="LabelInfoCredito"
                           FontSize="14"
                           TextColor="{StaticResource TextPrimary}"
                           IsVisible="False" />
                </StackLayout>
            </Frame>

            <!-- TABLA DE AMORTIZACIÓN -->
            <StackLayout x:Name="TablaSection" IsVisible="False" Spacing="16">
                <Frame BackgroundColor="{StaticResource BgCard}"
                       CornerRadius="12"
                       HasShadow="True"
                       Padding="16">
                    <StackLayout Spacing="16">
                        <Label Text="📊 Tabla de Amortización"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />

                        <!-- Headers de la tabla -->
                        <Grid BackgroundColor="{StaticResource Primary}"
                              Padding="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                                   Text="# Cuota"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   Text="Valor Cuota"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   Text="Interés"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3"
                                   Text="Capital"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="4"
                                   Text="Saldo"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" />
                        </Grid>

                        <!-- Lista de cuotas -->
                        <CollectionView x:Name="TablaCollectionView"
                                       MaximumHeightRequest="400">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8"
                                          BackgroundColor="{StaticResource BgCard}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Column="0"
                                               Text="{Binding NumeroCuota}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextPrimary}"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding ValorCuota, StringFormat='${0:F2}'}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextPrimary}"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="2"
                                               Text="{Binding InteresPagado, StringFormat='${0:F2}'}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextPrimary}"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="3"
                                               Text="{Binding CapitalPagado, StringFormat='${0:F2}'}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextPrimary}"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="4"
                                               Text="{Binding Saldo, StringFormat='${0:F2}'}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

                <!-- Información adicional sobre créditos -->
                <Frame BackgroundColor="{StaticResource BgCard}"
                       CornerRadius="12"
                       HasShadow="True"
                       Padding="16">
                    <StackLayout Spacing="8">
                        <Label Text="ℹ️ Información sobre Créditos BanQuito"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="• Tasa de interés: 16% anual"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Text="• Plazo mínimo: 3 meses"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Text="• Plazo máximo: 24 meses"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Text="• Cuotas fijas mensuales"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Text="• Sin comisiones adicionales"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                    </StackLayout>
                </Frame>
            </StackLayout>

        </StackLayout>
    </ScrollView>

</ContentPage>